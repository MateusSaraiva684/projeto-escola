# Copie este arquivo para .env e preencha os valores reais
# Nunca envie o .env para o git!

# URL do PostgreSQL — use postgresql:// ou postgres:// (o código ajusta automaticamente)
DATABASE_URL=postgresql://usuario:senha@host:5432/escola

# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-segura
